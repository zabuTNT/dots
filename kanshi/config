# Profili monitor (sostituisce displays.sh e autorandr). NON ANCORA TESTATO:
# dopo l'installazione guarda i nomi con `swaymsg -t get_outputs` e regola
# scala e posizione (o usa wdisplays per trovare i valori giusti).
# Il portatile ha un pannello 1920x1200: scala 1.0, valuta 1.25 o 1.5.

profile laptop {
    output eDP-1 enable mode 1920x1200 position 0,0 scale 1.0
}

# Portatile a sinistra, un monitor esterno a destra.
profile docked {
    output eDP-1 enable position 0,0 scale 1.0
    output "*" enable position 1920,0
}
